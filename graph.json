{"meta":{"kp_count":173,"triple_count":335,"question_count":422},"kps":[{"id":"KP000","name":"机器学习","category":"AI/ML基础","definition":"让计算机从数据中自动学习规律而非被显式编程的总称。","aliases":["机器学习","ML"]},{"id":"KP001","name":"监督学习","category":"AI/ML基础","definition":"用带标签的数据训练模型，让模型学会从输入映射到已知输出。","aliases":["监督学习","带标签训练"]},{"id":"KP002","name":"无监督学习","category":"AI/ML基础","definition":"用无标签数据训练，让模型自己发现数据中的结构或群组。","aliases":["无监督学习","无标签","聚类","客户分组"]},{"id":"KP003","name":"强化学习","category":"AI/ML基础","definition":"模型通过\"试错-奖励\"循环学会最大化长期收益的策略。","aliases":["强化学习","RL","奖励反馈"]},{"id":"KP004","name":"深度学习","category":"AI/ML基础","definition":"使用多层神经网络从数据中自动提取特征的机器学习子集。","aliases":["深度学习","神经网络","deep learning"]},{"id":"KP005","name":"决策树","category":"AI/ML基础","definition":"像流程图一样层层判断的算法，每一步根据特征取值分支。","aliases":["决策树"]},{"id":"KP006","name":"线性回归","category":"AI/ML基础","definition":"用一条直线拟合数据，用来预测连续数值（如房价）。","aliases":["线性回归"]},{"id":"KP007","name":"逻辑回归","category":"AI/ML基础","definition":"在线性回归基础上加sigmoid，用来预测二分类概率。","aliases":["逻辑回归"]},{"id":"KP008","name":"K近邻(KNN)","category":"AI/ML基础","definition":"看一个新样本周围最近的K个邻居多数属于哪一类。","aliases":["KNN","K 近邻","k-NN"]},{"id":"KP009","name":"K均值聚类","category":"AI/ML基础","definition":"把数据自动分成K个簇，使同簇样本相似度高。","aliases":["K 均值","K-Means","KMeans"]},{"id":"KP010","name":"朴素贝叶斯","category":"AI/ML基础","definition":"基于贝叶斯定理的概率分类器，假设特征之间相互独立。","aliases":["朴素贝叶斯"]},{"id":"KP011","name":"自编码器","category":"AI/ML基础","definition":"一种神经网络，学习把输入压缩再重建，用于异常检测。","aliases":["自编码器","autoencoder"]},{"id":"KP012","name":"生成对抗网络(GAN)","category":"AI/ML基础","definition":"由\"生成器\"和\"判别器\"对抗训练，用来生成逼真的合成数据。","aliases":["GAN","生成对抗网络"]},{"id":"KP013","name":"迁移学习","category":"AI/ML基础","definition":"借用已在大数据上训练好的模型，再在小数据上微调以解决新任务。","aliases":["迁移学习","transfer learning"]},{"id":"KP014","name":"联邦学习","category":"AI/ML基础","definition":"数据不出本地，多方协作训练共享模型，保护隐私。","aliases":["联邦学习"]},{"id":"KP015","name":"数据预处理","category":"AI/ML基础","definition":"清洗、转换、规范化原始数据的步骤，让数据适合喂给模型。","aliases":["数据预处理","数据清洗","数据准备"]},{"id":"KP016","name":"特征工程","category":"AI/ML基础","definition":"人为构造或挑选最能帮助模型预测的特征。","aliases":["特征工程","特征创建"]},{"id":"KP017","name":"探索性数据分析","category":"AI/ML基础","definition":"训练前用统计图表了解数据分布、相关性和异常。","aliases":["EDA","探索性数据分析"]},{"id":"KP018","name":"时间序列数据","category":"AI/ML基础","definition":"按时间顺序排列的数据点，常用于预测未来趋势。","aliases":["时间序列","时序数据"]},{"id":"KP019","name":"数据标注","category":"AI/ML基础","definition":"人工或工具给数据打上正确答案标签的过程。","aliases":["数据标注","标签数据","标注数据"]},{"id":"KP020","name":"训练/验证/测试集","category":"AI/ML基础","definition":"把数据三七开：训练模型、调参、最终评估。","aliases":["训练集","验证集","测试集","数据集划分"]},{"id":"KP021","name":"过拟合","category":"AI/ML基础","definition":"模型把训练数据背下来了，但遇到新数据就出错。","aliases":["过拟合","overfitting"]},{"id":"KP022","name":"类别不平衡","category":"AI/ML基础","definition":"训练数据中某些类别的样本远多于其他类别。","aliases":["类别不平衡","不平衡数据","数据增强"]},{"id":"KP023","name":"数据多样性","category":"AI/ML基础","definition":"训练数据覆盖各种人群、场景、口音等的能力。","aliases":["多样性","数据多样"]},{"id":"KP023a","name":"分类评估指标","category":"评估指标","definition":"用来评估分类任务（准确率/精确率/召回率/F1/混淆矩阵/AUC）等的总称。","aliases":["分类评估指标"]},{"id":"KP023b","name":"回归评估指标","category":"评估指标","definition":"用来评估回归任务（RMSE/R² 等）的总称。","aliases":["回归评估指标"]},{"id":"KP023c","name":"NLP评估指标","category":"评估指标","definition":"用来评估NLP生成质量（BLEU/ROUGE/BERTScore）的总称。","aliases":["NLP评估指标"]},{"id":"KP024","name":"准确率","category":"评估指标","definition":"所有样本中预测正确的比例，适合类别均衡的分类任务。","aliases":["准确率","accuracy"]},{"id":"KP025","name":"精确率","category":"评估指标","definition":"模型预测为正的样本里，实际真的是正的比例。","aliases":["精确率","precision"]},{"id":"KP026","name":"召回率","category":"评估指标","definition":"所有真实为正的样本中，被模型找出来的比例。","aliases":["召回率","recall"]},{"id":"KP027","name":"F1分数","category":"评估指标","definition":"精确率和召回率的调和平均，综合衡量分类效果。","aliases":["F1","F1 分数","F1 值"]},{"id":"KP028","name":"混淆矩阵","category":"评估指标","definition":"一个表格，展示模型每个类别的正确与错误分类数。","aliases":["混淆矩阵"]},{"id":"KP029","name":"AUC-ROC","category":"评估指标","definition":"ROC曲线下面积，衡量分类器区分正负样本的能力。","aliases":["AUC","ROC","AUC-ROC"]},{"id":"KP030","name":"均方根误差(RMSE)","category":"评估指标","definition":"预测值与真实值之间误差平方的平均值的平方根。","aliases":["RMSE","均方根误差"]},{"id":"KP031","name":"R²分数","category":"评估指标","definition":"回归模型解释数据方差的比例，越接近1越好。","aliases":["R²","决定系数"]},{"id":"KP032","name":"BLEU分数","category":"评估指标","definition":"比较机器翻译和人工参考译文的n-gram重合度。","aliases":["BLEU","双语评估替补"]},{"id":"KP033","name":"ROUGE分数","category":"评估指标","definition":"比较机器摘要和人工摘要的重合度，常用ROUGE-1/L。","aliases":["ROUGE"]},{"id":"KP034","name":"BERTScore","category":"评估指标","definition":"用BERT上下文向量计算两个句子的语义相似度。","aliases":["BERTScore"]},{"id":"KP035","name":"基准数据集","category":"评估指标","definition":"业内公认的标准化测试集，用来横向对比模型。","aliases":["基准数据集","benchmark"]},{"id":"KP036","name":"A/B测试","category":"评估指标","definition":"让真实用户随机使用两个版本，比较效果差异。","aliases":["A/B 测试","AB 测试"]},{"id":"KP036a","name":"生成式AI","category":"生成式AI","definition":"能够生成新内容（文本/图像/音频/代码等）的AI技术总称。","aliases":["生成式AI"]},{"id":"KP037","name":"大语言模型(LLM)","category":"生成式AI","definition":"Large Language Model：在海量文本上预训练、能理解和生成自然语言的大规模神经网络模型。代表：GPT-4、Claude、Amazon Nova、Amazon Titan。","aliases":["LLM","大语言模型","大型语言模型","GPT"]},{"id":"KP038","name":"基础模型(FM)","category":"生成式AI","definition":"在超大规模数据上预训练、可适配多种下游任务的通用大模型。","aliases":["FM","基础模型","foundation model"]},{"id":"KP039","name":"Transformer架构","category":"生成式AI","definition":"基于\"自注意力\"机制的神经网络架构，是LLM的基石。","aliases":["Transformer","自注意力","基于变压器的语言模型"]},{"id":"KP040","name":"嵌入(向量表示)","category":"生成式AI","definition":"把文本/图像转成一串数字向量，保留语义相似度关系。","aliases":["嵌入","embedding","向量表示","嵌入向量","词嵌入"]},{"id":"KP041","name":"标记(Token)","category":"生成式AI","definition":"模型处理文本的最小单位，可以是词、子词或字符。","aliases":["Token","标记","代币"]},{"id":"KP042","name":"上下文窗口","category":"生成式AI","definition":"模型一次性能\"看到\"的最大token数量。","aliases":["上下文窗口","上下文大小","最大长度"]},{"id":"KP043","name":"小型语言模型(SLM)","category":"生成式AI","definition":"参数和体积较小的语言模型，延迟低、可在端侧部署。","aliases":["SLM","小型语言模型","小型模型"]},{"id":"KP044","name":"多模态模型","category":"生成式AI","definition":"同时处理文本、图像、音频、视频等多种类型数据的模型。","aliases":["多模态","多模态语言模型","multimodal"]},{"id":"KP045","name":"扩散模型","category":"生成式AI","definition":"从纯噪声出发逐步去噪生成图像的模型（如Stable Diffusion）。","aliases":["扩散模型","Stable Diffusion"]},{"id":"KP046","name":"推理(Inference)","category":"生成式AI","definition":"训练好的模型对未见过的输入做出预测或生成输出。","aliases":["推理","inference"]},{"id":"KP047","name":"推理延迟","category":"生成式AI","definition":"模型从收到请求到返回结果所花的时间。","aliases":["推理延迟","延迟","response time","平均响应时间"]},{"id":"KP048","name":"推理吞吐量","category":"生成式AI","definition":"单位时间内模型能处理的请求数量。","aliases":["推理吞吐量","吞吐量"]},{"id":"KP049","name":"幻觉","category":"生成式AI","definition":"模型自信地编造看似合理但事实上错误或无依据的内容。","aliases":["幻觉","hallucination","不准确"]},{"id":"KP050","name":"温度参数","category":"生成式AI","definition":"Temperature：控制 LLM 输出随机性的超参数。值越高（趋近 1 或以上）输出越发散有创意；值越低（趋近 0）输出越确定保守。常见范围 0–1。","aliases":["温度","temperature"]},{"id":"KP051","name":"Top-K采样","category":"生成式AI","definition":"每步只从概率最高的K个token中挑选，控制输出多样性。","aliases":["Top-K","前 K 项","top-k"]},{"id":"KP052","name":"生成步骤","category":"生成式AI","definition":"扩散模型生成图像的去噪迭代次数，越多越精细。","aliases":["生成步骤","steps"]},{"id":"KP053","name":"CFG(无分类器指导)","category":"生成式AI","definition":"扩散模型参数，控制生成图像与文字描述的贴合程度。","aliases":["CFG","无分类器指导","classifier-free guidance"]},{"id":"KP054","name":"否定提示","category":"生成式AI","definition":"在提示里写明\"不要出现什么\"，避免生成不想要的内容。","aliases":["否定提示","负面提示","negative prompt"]},{"id":"KP055","name":"非确定性","category":"生成式AI","definition":"相同输入下模型每次输出可能不同（因采样+温度）。","aliases":["非确定性","不确定性"]},{"id":"KP056","name":"计算机视觉","category":"AI应用","definition":"让机器理解和处理图像/视频的任务总称。","aliases":["计算机视觉","CV","图像分类","物体检测"]},{"id":"KP057","name":"自然语言处理(NLP)","category":"AI应用","definition":"让机器理解、生成、分析自然语言的技术领域。","aliases":["NLP","自然语言处理"]},{"id":"KP058","name":"智能文档处理(IDP)","category":"AI应用","definition":"自动从文档中识别、提取并结构化所需信息。","aliases":["IDP","智能文档处理"]},{"id":"KP059","name":"推荐系统","category":"AI应用","definition":"根据用户历史行为预测其可能感兴趣的物品。","aliases":["推荐系统","推荐引擎","亚马逊个性化"]},{"id":"KP060","name":"异常检测","category":"AI应用","definition":"从数据中找出明显偏离正常模式的可疑样本。","aliases":["异常检测","异常模式","威胁检测"]},{"id":"KP061","name":"目标检测","category":"AI应用","definition":"在图像中标出物体的位置并识别其类别。","aliases":["目标检测","物体检测","object detection"]},{"id":"KP062","name":"文本生成","category":"AI应用","definition":"由模型自动产出自然语言文本（文章、代码、邮件等）。","aliases":["文本生成","text generation"]},{"id":"KP063","name":"图像生成","category":"AI应用","definition":"由模型根据文字描述（或其他条件）产出静态图像。代表：Stable Diffusion、DALL·E、Amazon Nova Canvas。","aliases":["图像生成","生成图像","image generation"]},{"id":"KP064","name":"视频生成","category":"AI应用","definition":"由模型生成几秒到几十秒短视频片段，可基于文本或图像驱动。代表：Amazon Nova Reel、Runway。","aliases":["视频生成","生成视频"]},{"id":"KP065","name":"语音识别(ASR)","category":"AI应用","definition":"自动语音识别(ASR)，把人类语音实时转为文字，常用于会议转录、字幕生成、客服呼叫分析。代表：Amazon Transcribe。","aliases":["语音识别","ASR","转录","语音转文字"]},{"id":"KP066","name":"文本转语音(TTS)","category":"AI应用","definition":"文本转语音，把书面文字合成为自然流畅的人声，常用于语音助手、有声读物、无障碍服务。代表：Amazon Polly。","aliases":["TTS","文本转语音","语音合成","Polly"]},{"id":"KP067","name":"翻译","category":"AI应用","definition":"把一种自然语言的文本自动转为另一种，保留语义。AWS 服务：Amazon Translate。","aliases":["翻译","机器翻译","亚马逊翻译"]},{"id":"KP068","name":"摘要","category":"AI应用","definition":"把长文档（文章/报告/邮件）压缩为保留核心要点的短文，常用 LLM 实现。","aliases":["摘要","summarization"]},{"id":"KP069","name":"情感分析","category":"AI应用","definition":"判断一段文本所表达的情感倾向（积极/消极/中性），常用于舆情监控、客户反馈分析。","aliases":["情感分析","sentiment"]},{"id":"KP070","name":"抄袭检测","category":"AI应用","definition":"判断一段文本是否由AI生成或源自其他来源。","aliases":["抄袭","抄袭检测"]},{"id":"KP071","name":"提示(Prompt)","category":"提示工程","definition":"用户给大模型的输入指令，用来引导模型输出。","aliases":["提示","prompt","提示语"]},{"id":"KP072","name":"系统提示","category":"提示工程","definition":"给模型设定角色、风格、边界等高级指令的隐藏提示。","aliases":["系统提示","system prompt"]},{"id":"KP073","name":"零样本提示","category":"提示工程","definition":"不给任何示例，直接让模型完成任务。","aliases":["零样本","zero-shot","0样本"]},{"id":"KP074","name":"少样本提示","category":"提示工程","definition":"在提示中给几个示例，让模型照葫芦画瓢完成任务。","aliases":["少样本","few-shot","提示中提供示例"]},{"id":"KP075","name":"思维链(CoT)","category":"提示工程","definition":"让模型\"一步步思考\"再给答案，提升复杂推理效果。","aliases":["CoT","思维链","chain-of-thought","思维链提示法"]},{"id":"KP076","name":"提示链式反应","category":"提示工程","definition":"把复杂任务拆成多步提示依次执行，前一步输出喂给下一步。","aliases":["提示链","prompt chaining"]},{"id":"KP077","name":"ReAct提示","category":"提示工程","definition":"让模型交替进行\"推理\"和\"调用工具行动\"的提示范式。","aliases":["ReAct","推理与行动"]},{"id":"KP078","name":"角色提示","category":"提示工程","definition":"在提示里给模型指定角色（\"你是教师\"），调整回答风格。","aliases":["角色","角色提示","角色描述"]},{"id":"KP079","name":"提示模板","category":"提示工程","definition":"把常用提示做成带占位符的模板，便于复用和团队共享。","aliases":["提示模板","prompt template"]},{"id":"KP080","name":"提示管理","category":"提示工程","definition":"集中创建、版本化、评估提示词的系统能力。","aliases":["提示管理","prompt management"]},{"id":"KP081","name":"提示注入攻击","category":"提示工程","definition":"攻击者在提示里塞恶意指令，操纵模型越权或泄露信息。","aliases":["提示注入","prompt injection"]},{"id":"KP082","name":"对抗性提示","category":"提示工程","definition":"专门设计用来防御或测试注入攻击的提示技术。","aliases":["对抗性提示"]},{"id":"KP083","name":"越狱","category":"提示工程","definition":"用巧妙话术绕过模型的安全限制，让它输出违规内容。","aliases":["越狱","jailbreak"]},{"id":"KP084","name":"提取提示模板","category":"提示工程","definition":"通过提示工程套出模型的系统提示词的攻击方式。","aliases":["提取提示模板"]},{"id":"KP085","name":"检索增强生成(RAG)","category":"RAG与微调","definition":"Retrieval-Augmented Generation：模型先从外部知识库检索相关文档，再基于检索内容生成答案。优势：知识实时更新、引用可追溯、减少幻觉。","aliases":["RAG","检索增强生成","检索增强型生成"]},{"id":"KP086","name":"知识库","category":"RAG与微调","definition":"RAG 中存放业务文档并支持按语义检索的数据库，Bedrock Knowledge Base 自动同步与索引文档。","aliases":["知识库","knowledge base"]},{"id":"KP087","name":"向量数据库","category":"RAG与微调","definition":"专门存储向量并支持按相似度（KNN/ANN）高效检索的数据库。AWS：OpenSearch、Aurora pgvector。","aliases":["向量数据库","向量索引","OpenSearch","Aurora"]},{"id":"KP088","name":"嵌入模型","category":"RAG与微调","definition":"把文本/图像转成向量的模型，用于语义搜索和检索。","aliases":["嵌入模型","文本嵌入模型"]},{"id":"KP088a","name":"多模态嵌入","category":"RAG与微调","definition":"能同时把文本、图像等多种模态映射到同一向量空间的嵌入模型。","aliases":["多模态嵌入","多模态嵌入模型"]},{"id":"KP089","name":"语义搜索","category":"RAG与微调","definition":"基于含义而非关键词匹配，找到最相关的文档片段。","aliases":["语义搜索","semantic search"]},{"id":"KP090","name":"分块","category":"RAG与微调","definition":"把长文档切成合适大小的段落，便于嵌入和检索。","aliases":["分块","chunking"]},{"id":"KP091","name":"预训练","category":"RAG与微调","definition":"用海量通用数据从零训练基础模型。","aliases":["预训练","从零训练","预训练基础模型"]},{"id":"KP092","name":"微调(Fine-tuning)","category":"RAG与微调","definition":"Fine-tuning：在已训练模型基础上用特定领域标注数据继续训练，使模型掌握该领域知识或风格。需准备领域数据集并付出训练算力。","aliases":["微调","fine-tuning","微调 FM","微调模型"]},{"id":"KP093","name":"指令微调","category":"RAG与微调","definition":"用\"指令-回答\"对训练模型更好地遵循人类指令。","aliases":["指令微调","instruction tuning"]},{"id":"KP094","name":"持续预训练","category":"RAG与微调","definition":"用新数据继续预训练，让模型学到最新领域知识。","aliases":["持续预训练","continual pretraining"]},{"id":"KP095","name":"RLHF","category":"RAG与微调","definition":"用人类偏好排序作为奖励信号进一步微调模型。","aliases":["RLHF","人类反馈强化学习"]},{"id":"KP096","name":"LoRA/PEFT","category":"RAG与微调","definition":"只训练少量附加参数就能让大模型适配新任务的高效微调方法。","aliases":["LoRA","PEFT","参数高效微调"]},{"id":"KP097","name":"域自适应","category":"RAG与微调","definition":"让模型学习特定行业（如法律、医疗）专门术语和风格。","aliases":["域自适应","领域自适应"]},{"id":"KP098","name":"模型评估","category":"RAG与微调","definition":"用自动或人工方法对模型输出打分，决定是否上线。","aliases":["模型评估","自动模型评估","评估"]},{"id":"KP099","name":"Amazon Bedrock","category":"Bedrock","definition":"AWS提供的无服务器平台，托管多家厂商的FM供API调用。","aliases":["Bedrock","亚马逊 Bedrock"]},{"id":"KP100","name":"Bedrock代理","category":"Bedrock","definition":"Bedrock上的智能体，可拆解任务、调用工具完成多步操作。","aliases":["Bedrock 代理","Bedrock Agent","代理","智能代理"]},{"id":"KP101","name":"Bedrock知识库","category":"Bedrock","definition":"Bedrock内置的RAG能力，自动同步文档并支持检索。","aliases":["Bedrock 知识库","Bedrock knowledge base"]},{"id":"KP102","name":"Bedrock防护栏","category":"Bedrock","definition":"在输入/输出层过滤有害、违规或隐私内容的策略机制。","aliases":["Bedrock 防护栏","Guardrails","安全防护措施"]},{"id":"KP103","name":"预配置吞吐量","category":"Bedrock","definition":"为自定义模型预留固定推理容量，保证性能稳定。","aliases":["预配置吞吐量","Provisioned Throughput"]},{"id":"KP104","name":"按需推理","category":"Bedrock","definition":"不预留、按调用量计费的弹性推理模式。","aliases":["按需","按需吞吐","按需推理"]},{"id":"KP105","name":"批量推理","category":"Bedrock","definition":"异步离线批量处理大量推理请求的模式。","aliases":["批量推理","batch inference"]},{"id":"KP106","name":"模型调用日志","category":"Bedrock","definition":"记录每次API调用的输入、输出、token用量等信息。","aliases":["模型调用日志","调用日志","模型调用日志记录"]},{"id":"KP107","name":"Bedrock模型评估","category":"Bedrock","definition":"Bedrock内置功能，让你用自定义数据集对比多个FM。","aliases":["Bedrock 模型评估","模型评估功能"]},{"id":"KP108","name":"Bedrock Studio","category":"Bedrock","definition":"Bedrock提供的团队协作开发实验环境（含PartyRock）。","aliases":["Bedrock Studio","派对摇滚","PartyRock"]},{"id":"KP109","name":"基础模型选择","category":"Bedrock","definition":"根据成本、性能、多模态、上下文窗口等挑选合适FM。","aliases":["基础模型选择","模型选择","选择 FM"]},{"id":"KP110","name":"模型定制","category":"Bedrock","definition":"对FM进行微调或继续预训练以适配业务。","aliases":["模型定制","定制 FM","定制基础模型"]},{"id":"KP111","name":"Amazon SageMaker","category":"SageMaker","definition":"AWS的全托管机器学习平台，覆盖数据到部署全流程。","aliases":["SageMaker","亚马逊 SageMaker","SageMaker AI"]},{"id":"KP112","name":"SageMaker Studio","category":"SageMaker","definition":"基于Web的IDE，集成Jupyter、实验追踪与团队协作。","aliases":["SageMaker Studio","统一工作室","Studio 笔记本"]},{"id":"KP113","name":"SageMaker Canvas","category":"SageMaker","definition":"面向业务人员的无代码ML工具，点点鼠标就能建模。","aliases":["SageMaker Canvas","Canvas"]},{"id":"KP114","name":"SageMaker JumpStart","category":"SageMaker","definition":"预置大量开源模型和示例解决方案，一键启动。","aliases":["JumpStart","SageMaker JumpStart"]},{"id":"KP115","name":"SageMaker Ground Truth","category":"SageMaker","definition":"数据标注服务，支持人工标注+主动学习。","aliases":["Ground Truth","标注任务"]},{"id":"KP116","name":"SageMaker Clarify","category":"SageMaker","definition":"检测训练数据和模型中的偏差，并提供特征重要性等可解释性。","aliases":["Clarify","SageMaker Clarify"]},{"id":"KP117","name":"SageMaker模型监控器","category":"SageMaker","definition":"生产环境中监控数据漂移、模型质量与偏差。","aliases":["模型监控器","SageMaker 模型监控器","Model Monitor"]},{"id":"KP118","name":"SageMaker模型卡片","category":"SageMaker","definition":"模型的标准文档卡，记录用途、性能、局限性等元信息。","aliases":["模型卡片","Model Card","SageMaker 模型卡片"]},{"id":"KP119","name":"SageMaker模型注册表","category":"SageMaker","definition":"集中管理模型版本、审批流和血缘关系的仓库。","aliases":["模型注册表","Model Registry"]},{"id":"KP120","name":"SageMaker特征存储库","category":"SageMaker","definition":"集中存储、管理、共享机器学习特征的服务。","aliases":["特征存储库","Feature Store"]},{"id":"KP121","name":"SageMaker无服务器推理","category":"SageMaker","definition":"无需管理服务器，按请求自动伸缩的推理模式。","aliases":["无服务器推理"]},{"id":"KP122","name":"SageMaker异步推理","category":"SageMaker","definition":"处理大payload、无需即时响应的推理队列。","aliases":["异步推理"]},{"id":"KP123","name":"SageMaker端点","category":"SageMaker","definition":"部署模型后对外提供HTTP/RPC调用的推理服务。","aliases":["端点","Endpoint","模型端点"]},{"id":"KP124","name":"SageMaker批量转换","category":"SageMaker","definition":"SageMaker批量转换(Batch Transform)：对大规模数据集离线运行推理生成预测，适合无需实时响应的场景（如批量评分、ETL）。","aliases":["批量转换","Batch Transform"]},{"id":"KP125","name":"SageMaker DeepAR","category":"SageMaker","definition":"SageMaker内置的时间序列预测算法。","aliases":["DeepAR"]},{"id":"KP126","name":"MLOps","category":"SageMaker","definition":"把DevOps理念应用到ML全生命周期（训练→部署→监控→再训练）。","aliases":["MLOps","机器学习运维"]},{"id":"KP127","name":"SageMaker管道","category":"SageMaker","definition":"编排ML工作流步骤，可重复执行的Pipeline。","aliases":["SageMaker 管道","Pipeline"]},{"id":"KP128","name":"SageMaker目录","category":"SageMaker","definition":"集中管理可批准的数据和模型资产。","aliases":["SageMaker 目录"]},{"id":"KP129","name":"Amazon Q Business","category":"Amazon Q","definition":"面向企业的生成式AI助手，可对接企业知识库回答问题。","aliases":["Q Business","亚马逊 Q 商业版"]},{"id":"KP130","name":"Amazon Q Developer","category":"Amazon Q","definition":"面向开发者的AI编程助手，支持代码生成、测试、文档等。","aliases":["Q Developer","亚马逊 Q 开发者","Amazon Q Developer"]},{"id":"KP131","name":"Amazon Q in QuickSight","category":"Amazon Q","definition":"在BI工具QuickSight中用自然语言生成图表与高管摘要。","aliases":["Q in QuickSight","QuickSight"]},{"id":"KP132","name":"Amazon Q Apps","category":"A